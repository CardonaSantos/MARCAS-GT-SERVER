model SesionTrackingUsuario {
  id                Int                  @id @default(autoincrement())
  usuarioId         Int
  asistenciaId      Int?
  estado            EstadoSesionTracking @default(ACTIVA)
  iniciadaEn        DateTime             @default(now())
  finalizadaEn      DateTime?
  ultimoHeartbeatEn DateTime             @default(now())
  motivoCierre      String?
  dispositivoId     String?
  plataforma        String?
  creadoEn          DateTime             @default(now())
  actualizadoEn     DateTime             @updatedAt

  usuario         Usuario                     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  asistencia      Asistencia?                 @relation(fields: [asistenciaId], references: [id], onDelete: SetNull)
  ubicaciones     UbicacionUsuarioHistorial[]
  ubicacionActual UbicacionUsuarioActual?

  @@index([usuarioId, estado])
  @@index([asistenciaId])
  @@index([ultimoHeartbeatEn])
}

model UbicacionUsuarioHistorial {
  id           Int      @id @default(autoincrement())
  sesionId     Int
  latitud      Decimal  @db.Decimal(10, 7)
  longitud     Decimal  @db.Decimal(10, 7)
  precisionM   Decimal? @db.Decimal(10, 2)
  velocidadMps Decimal? @db.Decimal(10, 2)
  bateriaPct   Int?
  capturadoEn  DateTime
  persistidoEn DateTime @default(now())

  sesion SesionTrackingUsuario @relation(fields: [sesionId], references: [id], onDelete: Cascade)

  @@index([sesionId, capturadoEn])
}

model UbicacionUsuarioActual {
  id            Int      @id @default(autoincrement())
  sesionId      Int      @unique
  usuarioId     Int      @unique
  latitud       Decimal  @db.Decimal(10, 7)
  longitud      Decimal  @db.Decimal(10, 7)
  precisionM    Decimal? @db.Decimal(10, 2)
  velocidadMps  Decimal? @db.Decimal(10, 2)
  bateriaPct    Int?
  capturadoEn   DateTime
  persistidoEn  DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  sesion  SesionTrackingUsuario @relation(fields: [sesionId], references: [id], onDelete: Cascade)
  usuario Usuario               @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

// ============================================================================
// INVENTARIO Y BODEGAS
// ============================================================================

model Bodega {
  id          Int     @id @default(autoincrement())
  empresaId   Int
  codigo      String  @unique
  nombre      String
  descripcion String?
  direccion   String?
  telefono    String?

  esPrincipal   Boolean @default(false)
  responsableId Int?

  activo             Boolean   @default(true)
  motivoInactivacion String?
  inactivadaEn       DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  responsable Usuario? @relation("BodegaResponsable", fields: [responsableId], references: [id], onDelete: SetNull)

  stocks                StockBodega[]
  movimientos           MovimientoInventario[]
  requisiciones         Requisicion[]
  transferenciasOrigen  TransferenciaBodega[]  @relation("TransferenciaBodegaOrigen")
  transferenciasDestino TransferenciaBodega[]  @relation("TransferenciaBodegaDestino")
  ordenesDespacho       OrdenDespacho[]
  enviosOrigen          Envio[]

  eventos BodegaEvento[]

  @@index([activo])
  @@index([esPrincipal])
  @@index([responsableId])
}

model BodegaEvento {
  id        Int              @id @default(autoincrement())
  bodegaId  Int
  usuarioId Int?
  tipo      TipoEventoBodega
  detalle   String?
  creadoEn  DateTime         @default(now())

  bodega  Bodega   @relation(fields: [bodegaId], references: [id], onDelete: Cascade)
  usuario Usuario? @relation("BodegaEventoUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([bodegaId, creadoEn])
  @@index([usuarioId])
}

enum TipoEventoBodega {
  CREADA
  ACTUALIZADA
  ACTIVADA
  DESACTIVADA
  RESPONSABLE_ASIGNADO
  RESPONSABLE_REMOVIDO
  ESTABLECIDA_PRINCIPAL
}

model StockBodega {
  id         Int @id @default(autoincrement())
  bodegaId   Int
  productoId Int

  cantidadReal       Int @default(0)
  cantidadReservada  Int @default(0)
  cantidadDisponible Int @default(0)

  costoPromedio Decimal @default(0) @db.Decimal(14, 4)

  // Control de concurrencia optimista.
  // Cada operación que modifique existencias incrementa la versión.
  version Int @default(0)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  bodega Bodega @relation(fields: [bodegaId], references: [id], onDelete: Restrict)

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  reservas ReservaInventario[]

  @@unique([bodegaId, productoId])
  // Consultas de inventario por bodega.
  @@index([bodegaId, cantidadDisponible])
  // Disponibilidad de un producto en todas las bodegas.
  @@index([productoId, cantidadDisponible])
}

model Requisicion {
  id              Int  @id @default(autoincrement())
  empresaId       Int
  bodegaDestinoId Int
  proveedorId     Int?
  solicitanteId   Int

  estado EstadoRequisicion @default(BORRADOR)

  observaciones String?

  solicitadaEn DateTime?
  aprobadaEn   DateTime?
  rechazadaEn  DateTime?
  canceladaEn  DateTime?
  completadaEn DateTime?

  motivoRechazo     String?
  motivoCancelacion String?

  // Concurrencia optimista para evitar que dos acciones
  // modifiquen el workflow simultáneamente.
  version Int @default(0)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  bodegaDestino Bodega @relation(fields: [bodegaDestinoId], references: [id], onDelete: Restrict)

  proveedor Proveedor? @relation(fields: [proveedorId], references: [id], onDelete: SetNull)

  solicitante Usuario @relation("RequisicionSolicitante", fields: [solicitanteId], references: [id], onDelete: Restrict)

  detalles    RequisicionDetalle[]
  recepciones RecepcionRequisicion[]
  eventos     RequisicionEvento[]

  @@index([empresaId, estado])
  @@index([bodegaDestinoId, estado])
  @@index([proveedorId, estado])
  @@index([solicitanteId, creadoEn])
  @@index([estado, creadoEn])
}

model RequisicionEvento {
  id            Int  @id @default(autoincrement())
  requisicionId Int
  usuarioId     Int?

  tipo TipoEventoRequisicion

  detalle String?

  creadoEn DateTime @default(now())

  requisicion Requisicion @relation(fields: [requisicionId], references: [id], onDelete: Cascade)

  usuario Usuario? @relation("RequisicionEventoUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([requisicionId, creadoEn])
  @@index([usuarioId])
  @@index([tipo, creadoEn])
}

model RequisicionDetalle {
  id            Int @id @default(autoincrement())
  requisicionId Int
  productoId    Int

  cantidadSolicitada Int
  cantidadRecibida   Int @default(0)

  costoUnitarioEstimado Decimal? @db.Decimal(14, 4)

  version Int @default(0)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  requisicion Requisicion @relation(fields: [requisicionId], references: [id], onDelete: Cascade)

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  recepcionDetalles RecepcionRequisicionDetalle[]

  @@unique([requisicionId, productoId])
  @@index([productoId])
}

model RecepcionRequisicion {
  id            Int @id @default(autoincrement())
  requisicionId Int
  recibidoPorId Int

  estado EstadoRecepcionRequisicion @default(PENDIENTE)

  // Protege una recepción completa contra reintentos HTTP.
  claveIdempotencia String @unique

  documentoReferencia String?
  observaciones       String?

  recibidoEn DateTime @default(now())

  // Se establece una vez que todas las líneas fueron
  // registradas correctamente en Inventario.
  aplicadaEn DateTime?

  // Permite detectar una operación que quedó pendiente
  // por un fallo técnico y reintentarla idempotentemente.
  errorAplicacion String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  requisicion Requisicion @relation(fields: [requisicionId], references: [id], onDelete: Restrict)

  recibidoPor Usuario @relation("RecepcionRequisicionRecibidoPor", fields: [recibidoPorId], references: [id], onDelete: Restrict)

  detalles RecepcionRequisicionDetalle[]

  @@index([requisicionId, recibidoEn])
  @@index([recibidoPorId, recibidoEn])
  @@index([estado, creadoEn])
}

model RecepcionRequisicionDetalle {
  id Int @id @default(autoincrement())

  recepcionId          Int
  requisicionDetalleId Int

  cantidad Int

  // Costo REAL de lo físicamente recibido.
  costoUnitario Decimal @db.Decimal(14, 4)

  creadoEn DateTime @default(now())

  recepcion RecepcionRequisicion @relation(fields: [recepcionId], references: [id], onDelete: Cascade)

  requisicionDetalle RequisicionDetalle @relation(fields: [requisicionDetalleId], references: [id], onDelete: Restrict)

  @@unique([recepcionId, requisicionDetalleId])
  @@index([requisicionDetalleId])
}

model TransferenciaBodega {
  id              Int @id @default(autoincrement())
  bodegaOrigenId  Int
  bodegaDestinoId Int
  creadoPorId     Int

  estado EstadoTransferenciaBodega @default(BORRADOR)

  observaciones     String?
  motivoCancelacion String?

  preparadaEn DateTime?
  enviadaEn   DateTime?
  recibidaEn  DateTime?
  canceladaEn DateTime?

  // Concurrencia optimista.
  version Int @default(0)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  bodegaOrigen Bodega @relation("TransferenciaBodegaOrigen", fields: [bodegaOrigenId], references: [id], onDelete: Restrict)

  bodegaDestino Bodega @relation("TransferenciaBodegaDestino", fields: [bodegaDestinoId], references: [id], onDelete: Restrict)

  creadoPor Usuario @relation("TransferenciaCreadaPor", fields: [creadoPorId], references: [id], onDelete: Restrict)

  detalles    TransferenciaBodegaDetalle[]
  operaciones TransferenciaBodegaOperacion[]
  eventos     TransferenciaBodegaEvento[]

  @@index([bodegaOrigenId, estado])
  @@index([bodegaDestinoId, estado])
  @@index([creadoPorId, creadoEn])
  @@index([estado, creadoEn])
}

model TransferenciaBodegaEvento {
  id              Int  @id @default(autoincrement())
  transferenciaId Int
  usuarioId       Int?

  tipo TipoEventoTransferenciaBodega

  detalle String?

  creadoEn DateTime @default(now())

  transferencia TransferenciaBodega @relation(fields: [transferenciaId], references: [id], onDelete: Cascade)

  usuario Usuario? @relation("TransferenciaEventoUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([transferenciaId, creadoEn])
  @@index([usuarioId])
  @@index([tipo, creadoEn])
}

model TransferenciaBodegaDetalle {
  id              Int @id @default(autoincrement())
  transferenciaId Int
  productoId      Int

  cantidadSolicitada Int
  cantidadEnviada    Int @default(0)
  cantidadRecibida   Int @default(0)

  observaciones String?

  // Control de concurrencia sobre cambios de cantidades.
  version Int @default(0)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  transferencia TransferenciaBodega @relation(fields: [transferenciaId], references: [id], onDelete: Cascade)

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  operacionDetalles TransferenciaBodegaOperacionDetalle[]

  @@unique([transferenciaId, productoId])
  @@index([productoId])
}

model TransferenciaBodegaOperacionDetalle {
  id                     Int @id @default(autoincrement())
  operacionId            Int
  transferenciaDetalleId Int

  cantidad Int

  // Costo real trasladado entre bodegas.
  //
  // SALIDA:
  // se obtiene del costo promedio devuelto por Inventario.
  //
  // RECEPCION:
  // utiliza el costo conservado por la salida física.
  costoUnitario Decimal? @db.Decimal(14, 4)

  creadoEn DateTime @default(now())

  operacion TransferenciaBodegaOperacion @relation(fields: [operacionId], references: [id], onDelete: Cascade)

  transferenciaDetalle TransferenciaBodegaDetalle @relation(fields: [transferenciaDetalleId], references: [id], onDelete: Restrict)

  @@unique([operacionId, transferenciaDetalleId])
  @@index([transferenciaDetalleId])
}

model TransferenciaBodegaOperacion {
  id              Int @id @default(autoincrement())
  transferenciaId Int
  usuarioId       Int

  tipo   TipoOperacionTransferenciaBodega
  estado EstadoOperacionTransferenciaBodega @default(PENDIENTE)

  // Identifica el comando HTTP/operación física completa.
  // Permite reintentar sin duplicar movimientos de inventario.
  claveIdempotencia String @unique

  documentoReferencia String?
  observaciones       String?

  // Fecha física de salida o recepción.
  ocurridaEn DateTime @default(now())

  // Momento en que todos los movimientos de inventario
  // correspondientes a esta operación quedaron aplicados.
  aplicadaEn DateTime?

  // Conservamos el error para recuperación/reintento.
  errorAplicacion String?

  // Permite controlar reintentos concurrentes de la misma operación.
  version Int @default(0)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  transferencia TransferenciaBodega @relation(fields: [transferenciaId], references: [id], onDelete: Restrict)

  usuario Usuario @relation("TransferenciaOperacionUsuario", fields: [usuarioId], references: [id], onDelete: Restrict)

  detalles TransferenciaBodegaOperacionDetalle[]

  @@index([transferenciaId, ocurridaEn])
  @@index([transferenciaId, tipo, estado])
  @@index([usuarioId, ocurridaEn])
  @@index([estado, creadoEn])
}

model MovimientoInventario {
  id Int @id @default(autoincrement())

  bodegaId   Int
  productoId Int

  proveedorId Int?
  creadoPorId Int?

  // Relación interna directa cuando el movimiento
  // pertenece a una reserva.
  reservaInventarioId Int?

  tipo TipoMovimientoInventario

  // Siempre positiva.
  // El tipo determina si entra, sale, reserva o libera.
  cantidad Int

  costoUnitario Decimal? @db.Decimal(14, 4)

  // Auditoría del costo promedio.
  costoPromedioAntes   Decimal @default(0) @db.Decimal(14, 4)
  costoPromedioDespues Decimal @default(0) @db.Decimal(14, 4)

  cantidadRealAntes   Int
  cantidadRealDespues Int

  reservadaAntes   Int
  reservadaDespues Int

  // Permite vincular el movimiento con otros dominios
  // sin acoplar Inventario directamente a ellos.
  referenciaTipo String?
  referenciaId   Int?

  // Protege contra reintentos de la misma operación.
  claveIdempotencia String? @unique

  observaciones String?

  creadoEn DateTime @default(now())

  bodega Bodega @relation(fields: [bodegaId], references: [id], onDelete: Restrict)

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  proveedor Proveedor? @relation(fields: [proveedorId], references: [id], onDelete: SetNull)

  creadoPor Usuario? @relation("MovimientoInventarioCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)

  reservaInventario ReservaInventario? @relation(fields: [reservaInventarioId], references: [id], onDelete: Restrict)

  @@index([bodegaId, productoId, creadoEn])
  @@index([productoId, creadoEn])
  @@index([bodegaId, creadoEn])
  @@index([referenciaTipo, referenciaId])
  @@index([reservaInventarioId, creadoEn])
  @@index([creadoPorId, creadoEn])
}

model ReservaInventario {
  id Int @id @default(autoincrement())

  pedidoDetalleId Int
  stockBodegaId   Int

  // Cantidad que se reservó originalmente.
  cantidadOriginal Int

  // Cantidad que todavía sigue apartada físicamente.
  cantidadPendiente Int

  // Cantidad de la reserva que ya terminó en despacho/salida.
  cantidadAplicada Int @default(0)

  // Cantidad que dejó de estar reservada sin salir del inventario.
  cantidadLiberada Int @default(0)

  estado EstadoReservaInventario @default(ACTIVA)

  // Se establece cuando toda la reserva terminó aplicada.
  aplicadaEn DateTime?

  // Se establece cuando toda la reserva terminó liberada.
  liberadaEn DateTime?

  // Cualquier forma de cierre definitivo:
  // aplicada, liberada, cancelada o mixta.
  cerradaEn DateTime?

  // Permite distinguir un cierre provocado por cancelación.
  canceladaEn DateTime?

  // También necesitamos concurrencia sobre operaciones parciales.
  version Int @default(0)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  pedidoDetalle PedidoDetalle @relation(fields: [pedidoDetalleId], references: [id], onDelete: Restrict)

  stockBodega StockBodega @relation(fields: [stockBodegaId], references: [id], onDelete: Restrict)

  movimientos MovimientoInventario[]

  @@unique([pedidoDetalleId, stockBodegaId])
  @@index([stockBodegaId, estado])
  @@index([pedidoDetalleId, estado])
  @@index([estado, actualizadoEn])
}

// ============================================================================
// PEDIDOS
// ============================================================================

model Pedido {
  id Int @id @default(autoincrement())

  // Identificador humano del pedido.
  // Nullable para no afectar registros históricos.
  numero String? @unique

  empresaId  Int
  clienteId  Int
  vendedorId Int
  visitaId   Int?

  estado        EstadoPedido        @default(BORRADOR)
  condicionPago CondicionPago
  estadoPago    EstadoPagoComercial @default(PENDIENTE)

  moneda String @default("GTQ")

  // subtotal:
  // total bruto antes de descuentos.
  subtotal Decimal @default(0) @db.Decimal(12, 2)

  // Suma de descuentos aplicados a las líneas.
  descuentoTotal Decimal @default(0) @db.Decimal(12, 2)

  // subtotal - descuentoTotal.
  total Decimal @default(0) @db.Decimal(12, 2)

  observaciones String?

  // Auditoría del workflow.
  validacionSolicitadaEn DateTime?
  confirmadoEn           DateTime?

  motivoCancelacion String?
  canceladoEn       DateTime?

  // Concurrencia optimista.
  version Int @default(0)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  vendedor Usuario @relation("PedidoVendedor", fields: [vendedorId], references: [id], onDelete: Restrict)

  visita Visita? @relation(fields: [visitaId], references: [id], onDelete: SetNull)

  detalles PedidoDetalle[]
  eventos  PedidoEvento[]

  solicitudesCredito            SolicitudCredito[]
  ordenesDespacho               OrdenDespacho[]
  pagos                         Pago[]
  cuentasPorCobrar              CuentaPorCobrar[]
  facturas                      Factura[]
  entregas                      Entrega[]
  operacionesIntegracionCredito OperacionIntegracionCreditoPedido[]

  @@index([empresaId, estado, creadoEn])
  @@index([clienteId, creadoEn])
  @@index([vendedorId, creadoEn])
  // Nuevos índices operativos.
  @@index([estado, creadoEn])
  @@index([estadoPago, creadoEn])
  @@index([visitaId])
}

model PedidoDetalle {
  id         Int @id @default(autoincrement())
  pedidoId   Int
  productoId Int

  cantidadSolicitada Int

  // Cantidad actualmente apartada en Inventario.
  cantidadReservada Int @default(0)

  // Cantidad que físicamente ya salió mediante Despacho.
  cantidadDespachada Int @default(0)

  // Cantidad confirmada como entregada al cliente.
  cantidadEntregada Int @default(0)

  // Snapshot comercial. No debe cambiar si después cambia Producto.precio.
  precioUnitario Decimal @db.Decimal(12, 2)

  // Descuento monetario total de esta línea.
  descuento Decimal @default(0) @db.Decimal(12, 2)

  // Neto de la línea:
  // cantidadSolicitada * precioUnitario - descuento.
  subtotal Decimal @db.Decimal(12, 2)

  observaciones String?

  // Concurrencia optimista.
  version Int @default(0)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  reservas         ReservaInventario[]
  despachoDetalles OrdenDespachoDetalle[]
  entregaDetalles  EntregaDetalle[]
  facturaDetalles  FacturaDetalle[]

  @@unique([pedidoId, productoId])
  @@index([productoId])
}

model PedidoEvento {
  id        Int  @id @default(autoincrement())
  pedidoId  Int
  usuarioId Int?

  tipo TipoEventoPedido

  detalle String?

  // Referencia lógica opcional al agregado que originó el evento.
  //
  // Ejemplos futuros:
  // SOLICITUD_CREDITO / 15
  // ORDEN_DESPACHO    / 82
  // ENTREGA           / 31
  //
  // No se usa FK deliberadamente para no acoplar bounded contexts.
  referenciaTipo String?
  referenciaId   Int?

  creadoEn DateTime @default(now())

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  usuario Usuario? @relation("PedidoEventoUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([pedidoId, creadoEn])
  @@index([tipo, creadoEn])
  @@index([referenciaTipo, referenciaId])
}

