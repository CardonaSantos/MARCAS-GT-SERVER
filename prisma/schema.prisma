model FelContingencia {
  id                      Int @id @default(autoincrement())
  empresaId               Int
  establecimientoFiscalId Int

  estado EstadoContingenciaFel @default(ABIERTA)

  inicioEn DateTime
  finEn    DateTime?

  motivo String

  abiertaPorId Int?
  cerradaPorId Int?

  notificadaSatEn DateTime?

  claveIdempotencia String? @unique
  version           Int @default(0)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  empresa         Empresa               @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  establecimiento EstablecimientoFiscal @relation(fields: [establecimientoFiscalId], references: [id], onDelete: Restrict)
  abiertaPor       Usuario?              @relation("FelContingenciaAbiertaPor", fields: [abiertaPorId], references: [id], onDelete: SetNull)
  cerradaPor       Usuario?              @relation("FelContingenciaCerradaPor", fields: [cerradaPorId], references: [id], onDelete: SetNull)

  documentos DocumentoFiscal[]

  @@index([empresaId, estado, inicioEn])
  @@index([establecimientoFiscalId, estado, inicioEn])
}











