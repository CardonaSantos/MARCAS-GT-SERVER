enum TipoEvidenciaEntrega {
  FIRMA
  FOTO
  DOCUMENTO
  GPS
  OTRO
}

enum TipoTransportista {
  INTERNO
  EXTERNO
}

enum EstadoVehiculo {
  DISPONIBLE
  RESERVADO
  EN_RUTA
  MANTENIMIENTO
  FUERA_SERVICIO
  INACTIVO
}

enum EstadoEnvio {
