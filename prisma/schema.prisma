  VERIFICADO
  RECHAZADO
  ANULADO
}

enum EstadoCuentaPorCobrar {
  PENDIENTE
  PARCIAL
  PAGADA
  VENCIDA
  ANULADA
}

enum EstadoFactura {
  BORRADOR
  EMITIDA
  ANULADA
}

enum EstadoSolicitudCredito {
  PENDIENTE
  EN_REVISION
  APROBADA
  RECHAZADA
  CANCELADA
}

enum TipoReferenciaCredito {
  PERSONAL
  COMERCIAL
  LABORAL
  OTRA
}

enum EstadoVerificacionReferencia {
  PENDIENTE
  VERIFICADA
  NO_VERIFICADA
  RECHAZADA
}

enum TipoDocumentoCredito {
  DPI
  NIT
  ESTADO_CUENTA
  CONSTANCIA_INGRESOS
  PATENTE
  OTRO
}

enum EstadoDocumentoCredito {
  PENDIENTE
  VALIDADO
  RECHAZADO
}

enum TipoDecisionCredito {
  APROBADA
  RECHAZADA
  AJUSTADA
}

enum EstadoOrdenDespacho {
  PENDIENTE
  PREPARANDO
  PREPARADA
  DESPACHADA
  PARCIAL
  CANCELADA
}

enum TipoEventoOrdenDespacho {
  CREADA
  PREPARACION_INICIADA
  PREPARADA
  DESPACHO_PARCIAL
  DESPACHADA
  CANCELADA
  OBSERVACION
}

enum EstadoEntrega {
