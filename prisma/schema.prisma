model PoliticaCredito {
  id                 Int      @id @default(autoincrement())
  empresaId          Int
  nombre             String
  descripcion        String?
  activo             Boolean  @default(true)
  montoMaximo        Decimal? @db.Decimal(12, 2)
  plazoMaximoDias    Int?
  porcentajeAnticipo Decimal? @db.Decimal(5, 2)

  motivoInactivacion String?
  inactivadaEn       DateTime?
  version            Int       @default(0)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  empresa     Empresa                    @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  requisitos  PoliticaCreditoRequisito[]
  solicitudes SolicitudCredito[]

  @@index([empresaId, activo])
}

model PoliticaCreditoRequisito {
  id          Int     @id @default(autoincrement())
  politicaId  Int
  codigo      String
  nombre      String
  descripcion String?
  obligatorio Boolean @default(true)
  orden       Int     @default(0)

  activo  Boolean @default(true)
  version Int     @default(0)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  politica PoliticaCredito @relation(fields: [politicaId], references: [id], onDelete: Cascade)

  solicitudes SolicitudCreditoRequisito[]

  @@unique([politicaId, codigo])
  @@index([politicaId, activo, orden])
}

model SolicitudCreditoRequisito {
  id Int @id @default(autoincrement())

  solicitudId         Int
  politicaRequisitoId Int?

  // Snapshot.
  codigo      String
  nombre      String
  descripcion String?
  obligatorio Boolean @default(true)
  orden       Int     @default(0)

  estado        EstadoRequisitoSolicitudCredito @default(PENDIENTE)
  observaciones String?

  revisadoPorId Int?
  revisadoEn    DateTime?

  version Int @default(0)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  solicitud SolicitudCredito @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  politicaRequisito PoliticaCreditoRequisito? @relation(fields: [politicaRequisitoId], references: [id], onDelete: SetNull)

  revisadoPor Usuario? @relation("SolicitudCreditoRequisitoRevisadoPor", fields: [revisadoPorId], references: [id], onDelete: SetNull)

  @@unique([solicitudId, codigo])
  @@index([solicitudId, estado])
  @@index([politicaRequisitoId])
  @@index([revisadoPorId])
}

model SolicitudCredito {
  id Int @id @default(autoincrement())

  numero String? @unique

  empresaId     Int
  pedidoId      Int
  clienteId     Int
  solicitanteId Int
  politicaId    Int?
  creditoId     Int? @unique

  montoSolicitado   Decimal @db.Decimal(12, 2)
  plazoDias         Int
  anticipoPropuesto Decimal @default(0) @db.Decimal(12, 2)

  estado EstadoSolicitudCredito @default(PENDIENTE)
  motivo String?

  solicitadaEn DateTime  @default(now())
  enRevisionEn DateTime?
  resueltaEn   DateTime?

  canceladaEn       DateTime?
  motivoCancelacion String?

  version Int @default(0)

  actualizadoEn DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Restrict)

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  solicitante Usuario @relation("SolicitudCreditoSolicitante", fields: [solicitanteId], references: [id], onDelete: Restrict)

  politica PoliticaCredito? @relation(fields: [politicaId], references: [id], onDelete: SetNull)

  credito Credito? @relation(fields: [creditoId], references: [id], onDelete: SetNull)

  requisitos  SolicitudCreditoRequisito[]
  referencias ReferenciaCredito[]
  documentos  DocumentoCredito[]
  decision    DecisionCredito?
  eventos     SolicitudCreditoEvento[]

  operacionPedido OperacionIntegracionCreditoPedido?

  @@index([empresaId, estado, solicitadaEn])
  @@index([pedidoId, estado])
  @@index([clienteId, estado, solicitadaEn])
  @@index([solicitanteId, estado, solicitadaEn])
  @@index([politicaId, estado])
}

model SolicitudCreditoEvento {
  id Int @id @default(autoincrement())

  solicitudId Int
  usuarioId   Int?

  tipo    TipoEventoSolicitudCredito
  detalle String?

  referenciaTipo String?
  referenciaId   Int?

  creadoEn DateTime @default(now())

  solicitud SolicitudCredito @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  usuario Usuario? @relation("SolicitudCreditoEventoUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([solicitudId, creadoEn])
  @@index([usuarioId])
  @@index([tipo, creadoEn])
  @@index([referenciaTipo, referenciaId])
}

model OperacionIntegracionCreditoPedido {
  id Int @id @default(autoincrement())

  solicitudId Int @unique
  pedidoId    Int
  actorId     Int

  tipo   TipoOperacionIntegracionCreditoPedido
  estado EstadoOperacionIntegracionCreditoPedido @default(PENDIENTE)

  claveIdempotencia String @unique

  intentos    Int     @default(0)
  ultimoError String?

  creadoEn      DateTime  @default(now())
  aplicadaEn    DateTime?
  actualizadoEn DateTime  @updatedAt

  solicitud SolicitudCredito @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Restrict)

  actor Usuario @relation("OperacionIntegracionCreditoPedidoActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([pedidoId, estado])
  @@index([estado, creadoEn])
  @@index([actorId])
}

model ReferenciaCredito {
  id          Int                   @id @default(autoincrement())
  solicitudId Int
  tipo        TipoReferenciaCredito
  nombre      String
  telefono    String
  relacion    String?

  resultado EstadoVerificacionReferencia @default(PENDIENTE)

  verificadoPorId Int?
  verificadoEn    DateTime?

  observaciones String?
  version       Int     @default(0)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  solicitud SolicitudCredito @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  verificadoPor Usuario? @relation("ReferenciaCreditoVerificadoPor", fields: [verificadoPorId], references: [id], onDelete: SetNull)

  @@index([solicitudId, resultado])
  @@index([solicitudId, creadoEn])
  @@index([verificadoPorId])
}

model DocumentoCredito {
  id          Int                  @id @default(autoincrement())
  solicitudId Int
  tipo        TipoDocumentoCredito

  url      String
  key      String?
  mimeType String?
  size     Int?

  estado EstadoDocumentoCredito @default(PENDIENTE)

  revisadoPorId Int?
  revisadoEn    DateTime?

  observaciones String?
  version       Int     @default(0)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  solicitud SolicitudCredito @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  revisadoPor Usuario? @relation("DocumentoCreditoRevisadoPor", fields: [revisadoPorId], references: [id], onDelete: SetNull)

  @@index([solicitudId, tipo])
  @@index([solicitudId, estado])
  @@index([revisadoPorId])
}

model DecisionCredito {
  id Int @id @default(autoincrement())

  solicitudId   Int @unique
  decididoPorId Int

  tipo TipoDecisionCredito

  montoAutorizado     Decimal? @db.Decimal(12, 2)
  plazoAutorizadoDias Int?
  anticipoRequerido   Decimal? @db.Decimal(12, 2)

  observaciones String?

  claveIdempotencia String? @unique

  creadoEn DateTime @default(now())

  solicitud SolicitudCredito @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  decididoPor Usuario @relation("DecisionCreditoUsuario", fields: [decididoPorId], references: [id], onDelete: Restrict)

  @@index([solicitudId, creadoEn])
}

// ============================================================================
// PREPARACION, DESPACHO Y ENTREGA
// ============================================================================

model OrdenDespacho {
  id       Int @id @default(autoincrement())
  pedidoId Int
  bodegaId Int

  creadoPorId     Int?
  preparadoPorId  Int?
  despachadoPorId Int?
  canceladoPorId  Int?

  numero String? @unique

  estado EstadoOrdenDespacho @default(PENDIENTE)

  programadoEn          DateTime?
  preparacionIniciadaEn DateTime?
  preparadoEn           DateTime?
  despachadoEn          DateTime?
  canceladoEn           DateTime?

  motivoCancelacion String?
  observaciones     String?

  version Int @default(0)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  bodega Bodega @relation(fields: [bodegaId], references: [id], onDelete: Restrict)

  creadoPor Usuario? @relation("OrdenDespachoCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)

  preparadoPor Usuario? @relation("OrdenDespachoPreparadoPor", fields: [preparadoPorId], references: [id], onDelete: SetNull)

  despachadoPor Usuario? @relation("OrdenDespachoDespachadoPor", fields: [despachadoPorId], references: [id], onDelete: SetNull)

  canceladoPor Usuario? @relation("OrdenDespachoCanceladoPor", fields: [canceladoPorId], references: [id], onDelete: SetNull)

  detalles OrdenDespachoDetalle[]
  eventos  OrdenDespachoEvento[]

  // NUEVO
  operaciones OperacionDespacho[]

  envios   EnvioDespacho[]
  entregas Entrega[]

  @@index([pedidoId, estado])
  @@index([bodegaId, estado])
  @@index([estado, creadoEn])
  @@index([estado, programadoEn])
  @@index([creadoPorId, creadoEn])
  @@index([preparadoPorId, preparadoEn])
  @@index([despachadoPorId, despachadoEn])
  @@index([canceladoPorId, canceladoEn])
}

model OperacionDespacho {
  id              Int @id @default(autoincrement())
  ordenDespachoId Int
  usuarioId       Int

  tipo   TipoOperacionDespacho
  estado EstadoOperacionDespacho @default(PENDIENTE)

  claveIdempotencia String  @unique
  observaciones     String?

  ocurridaEn      DateTime  @default(now())
  iniciadaEn      DateTime?
  ultimoIntentoEn DateTime?
  aplicadaEn      DateTime?
  fallidaEn       DateTime?

  intentos Int @default(0)

  errorAplicacion String?

  version Int @default(0)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @default(now()) @updatedAt

  ordenDespacho OrdenDespacho @relation(fields: [ordenDespachoId], references: [id], onDelete: Restrict)

  usuario Usuario @relation("OperacionDespachoUsuario", fields: [usuarioId], references: [id], onDelete: Restrict)

  detalles OperacionDespachoDetalle[]

  @@index([ordenDespachoId, ocurridaEn])
  @@index([ordenDespachoId, tipo, estado])
  @@index([usuarioId, ocurridaEn])
  @@index([estado, actualizadoEn])
  @@index([tipo, ocurridaEn])
}

model OrdenDespachoDetalle {
  id              Int @id @default(autoincrement())
  ordenDespachoId Int
  pedidoDetalleId Int
  productoId      Int

  cantidadProgramada Int @default(0)
  cantidadPreparada  Int @default(0)
  cantidadDespachada Int @default(0)

  observaciones String?
  version       Int     @default(0)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @default(now()) @updatedAt

  ordenDespacho OrdenDespacho @relation(fields: [ordenDespachoId], references: [id], onDelete: Cascade)

  pedidoDetalle PedidoDetalle @relation(fields: [pedidoDetalleId], references: [id], onDelete: Restrict)

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  entregaDetalles EntregaDetalle[]
  cargasEnvio     EnvioCargaDetalle[]

  // NUEVO
  operacionDetalles OperacionDespachoDetalle[]

  @@unique([ordenDespachoId, pedidoDetalleId])
  @@index([pedidoDetalleId])
  @@index([productoId])
}

model OperacionDespachoDetalle {
  id                     Int @id @default(autoincrement())
  operacionId            Int
  ordenDespachoDetalleId Int

  cantidad Int

  estado EstadoDetalleOperacionDespacho @default(PENDIENTE)

  // REFERENCIAS LOGICAS A INVENTARIO.
  // No llevan @relation ni FK.
  reservaInventarioId    Int?
  movimientoInventarioId Int? @unique

  // Idempotencia por línea.
  claveIdempotencia String @unique

  aplicadaEn DateTime?

  errorAplicacion String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @default(now()) @updatedAt

  operacion OperacionDespacho @relation(fields: [operacionId], references: [id], onDelete: Cascade)

  ordenDespachoDetalle OrdenDespachoDetalle @relation(fields: [ordenDespachoDetalleId], references: [id], onDelete: Restrict)

  @@unique([operacionId, ordenDespachoDetalleId])
  @@index([ordenDespachoDetalleId])
  @@index([estado, actualizadoEn])
  @@index([reservaInventarioId])
}

model OrdenDespachoEvento {
  id              Int  @id @default(autoincrement())
  ordenDespachoId Int
  usuarioId       Int?

  tipo    TipoEventoOrdenDespacho
  detalle String?

  // Referencia lógica a una operación de otro bounded context.
  // Ejemplo:
  // referenciaTipo = "MOVIMIENTO_INVENTARIO"
  // referenciaId   = 841
  referenciaTipo String?
  referenciaId   Int?

  // Protege reintentos de operaciones externas.
  claveIdempotencia String? @unique

  // Snapshot opcional de datos del evento:
  // cantidades, pedidoDetalleId, productoId, motivo, etc.
  metadata Json?

  creadoEn DateTime @default(now())

  ordenDespacho OrdenDespacho @relation(fields: [ordenDespachoId], references: [id], onDelete: Cascade)
  usuario       Usuario?      @relation("OrdenDespachoEventoUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([ordenDespachoId, creadoEn])
  @@index([tipo, creadoEn])
  @@index([usuarioId, creadoEn])
  @@index([referenciaTipo, referenciaId])
}

model Entrega {
  id              Int @id @default(autoincrement())
  ordenDespachoId Int
  pedidoId        Int
  clienteId       Int

  registradoPorId Int?

  estado EstadoEntrega @default(PENDIENTE)

  // Datos de quien recibe físicamente la mercadería.
  receptorNombre    String?
  receptorDocumento String?

  // Ubicación real donde se registró el resultado.
  latitud  Decimal? @db.Decimal(10, 7)
  longitud Decimal? @db.Decimal(10, 7)

  // Workflow.
  iniciadaEn   DateTime?
  entregadoEn  DateTime?
  finalizadaEn DateTime?

  // Se utiliza cuando la entrega termina sin completarse.
  motivoNoEntrega  MotivoNoEntrega?
  detalleNoEntrega String?

  observaciones String?

  // Permite proteger la creación/reintento de una entrega.
  claveIdempotencia String? @unique

  // Concurrencia optimista.
  version Int @default(0)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // Relación pública con la parada de Transporte.
  //
  // Una parada solo puede producir una Entrega.
  // Puede ser null para soportar una entrega manual/directa.
  envioDespachoId Int?           @unique
  envioDespacho   EnvioDespacho? @relation(fields: [envioDespachoId], references: [id], onDelete: SetNull)

  ordenDespacho OrdenDespacho @relation(fields: [ordenDespachoId], references: [id], onDelete: Restrict)

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Restrict)

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  registradoPor Usuario? @relation("EntregaRegistradaPor", fields: [registradoPorId], references: [id], onDelete: SetNull)

  detalles   EntregaDetalle[]
  evidencias EntregaEvidencia[]
  eventos    EntregaEvento[]

  facturas FacturaEntrega[]

  @@index([envioDespachoId, estado])
  @@index([pedidoId, estado])
  @@index([ordenDespachoId, estado])
  @@index([clienteId, estado, creadoEn])
  @@index([registradoPorId, creadoEn])
  @@index([estado, creadoEn])
}

model EntregaDetalle {
  id                     Int @id @default(autoincrement())
  entregaId              Int
  ordenDespachoDetalleId Int
  pedidoDetalleId        Int
  productoId             Int

  cantidadEntregada Int @default(0)
  cantidadRechazada Int @default(0)

  motivoRechazo String?

  // Concurrencia optimista.
  version Int @default(0)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  entrega Entrega @relation(fields: [entregaId], references: [id], onDelete: Cascade)

  ordenDespachoDetalle OrdenDespachoDetalle @relation(fields: [ordenDespachoDetalleId], references: [id], onDelete: Restrict)

  pedidoDetalle PedidoDetalle @relation(fields: [pedidoDetalleId], references: [id], onDelete: Restrict)

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  facturaDetalles FacturaDetalle[]

  @@unique([entregaId, ordenDespachoDetalleId])
  @@index([pedidoDetalleId])
  @@index([productoId])
  @@index([ordenDespachoDetalleId])
}

model EntregaEvidencia {
  id        Int @id @default(autoincrement())
  entregaId Int

  tipo TipoEvidenciaEntrega

  url      String
  key      String?
  mimeType String?
  size     Int?

  descripcion String?

  // Evita duplicar evidencia por reintentos de subida.
  claveIdempotencia String? @unique

  creadoEn DateTime @default(now())

  entrega Entrega @relation(fields: [entregaId], references: [id], onDelete: Cascade)

  @@index([entregaId, tipo])
  @@index([entregaId, creadoEn])
}

model EntregaEvento {
  id        Int  @id @default(autoincrement())
  entregaId Int
  usuarioId Int?

  tipo   TipoEventoEntrega
  estado EstadoEntrega

  detalle String?

  // Referencia lógica a otro bounded context.
  //
  // Ejemplos:
  //
  // ENVIO_DESPACHO / 41
  // PEDIDO         / 82
  // FACTURA        / 19
  //
  // No se utiliza FK deliberadamente.
  referenciaTipo String?
  referenciaId   Int?

  // Protege eventos derivados de comandos reintentados.
  claveIdempotencia String? @unique

  // Snapshot adicional del evento.
  //
  // Ejemplo:
  // {
  //   cantidadEntregada: 8,
  //   cantidadRechazada: 2
  // }
  metadata Json?

  creadoEn DateTime @default(now())

  entrega Entrega @relation(fields: [entregaId], references: [id], onDelete: Cascade)

  usuario Usuario? @relation("EntregaEventoUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([entregaId, creadoEn])
  @@index([tipo, creadoEn])
  @@index([estado, creadoEn])
  @@index([usuarioId, creadoEn])
  @@index([referenciaTipo, referenciaId])
}

// ============================================================================
// TRANSPORTE
// ============================================================================

model Transportista {
  id        Int               @id @default(autoincrement())
  empresaId Int
  codigo    String?
  tipo      TipoTransportista
  nombre    String
  telefono  String?
  correo    String?

  activo             Boolean   @default(true)
  motivoInactivacion String?
  inactivadaEn       DateTime?
  version            Int       @default(0)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  empresa     Empresa     @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  vehiculos   Vehiculo[]
  conductores Conductor[]
  envios      Envio[]

  @@unique([empresaId, codigo])
  @@index([empresaId, tipo, activo])
  @@index([empresaId, activo, nombre])
}

model Vehiculo {
  id              Int            @id @default(autoincrement())
  empresaId       Int
  transportistaId Int?
  placa           String
  marca           String?
  modelo          String?
  capacidadKg     Decimal?       @db.Decimal(12, 2)
  estado          EstadoVehiculo @default(DISPONIBLE)

  activo             Boolean   @default(true)
  motivoInactivacion String?
  inactivadaEn       DateTime?
  version            Int       @default(0)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  empresa       Empresa        @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  transportista Transportista? @relation(fields: [transportistaId], references: [id], onDelete: SetNull)
  envios        Envio[]

  @@unique([empresaId, placa])
  @@index([empresaId, estado, activo])
  @@index([transportistaId, estado, activo])
}

model Conductor {
  id              Int             @id @default(autoincrement())
  empresaId       Int
  transportistaId Int?
  nombre          String
  telefono        String?
  licencia        String?
  estado          EstadoConductor @default(DISPONIBLE)

  activo             Boolean   @default(true)
  motivoInactivacion String?
  inactivadaEn       DateTime?
  version            Int       @default(0)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  empresa       Empresa        @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  transportista Transportista? @relation(fields: [transportistaId], references: [id], onDelete: SetNull)
  envios        Envio[]

  @@index([empresaId, estado, activo])
  @@index([transportistaId, estado, activo])
}

model Envio {
  id        Int    @id @default(autoincrement())
  numero    String @unique
  empresaId Int
  bodegaId  Int?

  modalidad TipoTransportista @default(INTERNO)

  transportistaId Int?
  vehiculoId      Int?
  conductorId     Int?
  responsableId   Int?

  creadoPorId          Int?
  asignadoPorId        Int?
  cargaConfirmadaPorId Int?
  iniciadoPorId        Int?
  completadoPorId      Int?
  canceladoPorId       Int?

  estado EstadoEnvio @default(PROGRAMADO)

  salidaProgramadaEn DateTime?
  entregaEstimadaEn  DateTime?
  asignadoEn         DateTime?
  cargaConfirmadaEn  DateTime?

  guia                     String?
  costo                    Decimal?  @db.Decimal(12, 2)
  trackingUrl              String?
  comprobanteUrl           String?
  entregadoTransportistaEn DateTime?
  salidaEn                 DateTime?
  completadoEn             DateTime?

  canceladoEn       DateTime?
  motivoCancelacion String?
  observaciones     String?

  version Int @default(0)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  bodega  Bodega? @relation(fields: [bodegaId], references: [id], onDelete: Restrict)

  transportista Transportista? @relation(fields: [transportistaId], references: [id], onDelete: SetNull)
  vehiculo      Vehiculo?      @relation(fields: [vehiculoId], references: [id], onDelete: SetNull)
  conductor     Conductor?     @relation(fields: [conductorId], references: [id], onDelete: SetNull)

  responsable Usuario? @relation("EnvioResponsable", fields: [responsableId], references: [id], onDelete: SetNull)

  creadoPor          Usuario? @relation("EnvioCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)
  asignadoPor        Usuario? @relation("EnvioAsignadoPor", fields: [asignadoPorId], references: [id], onDelete: SetNull)
  cargaConfirmadaPor Usuario? @relation("EnvioCargaConfirmadaPor", fields: [cargaConfirmadaPorId], references: [id], onDelete: SetNull)
  iniciadoPor        Usuario? @relation("EnvioIniciadoPor", fields: [iniciadoPorId], references: [id], onDelete: SetNull)
  completadoPor      Usuario? @relation("EnvioCompletadoPor", fields: [completadoPorId], references: [id], onDelete: SetNull)
  canceladoPor       Usuario? @relation("EnvioCanceladoPor", fields: [canceladoPorId], references: [id], onDelete: SetNull)

  despachos   EnvioDespacho[]
  eventos     EnvioEvento[]
  incidencias EnvioIncidencia[]

  @@index([empresaId, estado, creadoEn])
  @@index([bodegaId, estado, creadoEn])
  @@index([transportistaId, estado, creadoEn])
  @@index([vehiculoId, estado])
  @@index([conductorId, estado])
  @@index([responsableId, estado])
  @@index([salidaProgramadaEn, estado])
  @@index([guia])
}

model EnvioDespacho {
  id              Int @id @default(autoincrement())
  envioId         Int
  ordenDespachoId Int
  clienteId       Int

  secuencia Int

  // Snapshot histórico del destino. Nunca se recalcula si Cliente cambia.
  destinatario     String
  telefonoDestino  String?
  direccionDestino String
  latitudDestino   Decimal? @db.Decimal(10, 7)
  longitudDestino  Decimal? @db.Decimal(10, 7)

  estado  EstadoParadaEnvio @default(PENDIENTE)
  version Int               @default(0)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  envio         Envio         @relation(fields: [envioId], references: [id], onDelete: Cascade)
  ordenDespacho OrdenDespacho @relation(fields: [ordenDespachoId], references: [id], onDelete: Restrict)
  cliente       Cliente       @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  cargas  EnvioCargaDetalle[]
  entrega Entrega?

  @@unique([envioId, ordenDespachoId])
  @@unique([envioId, secuencia])
  @@index([ordenDespachoId])
  @@index([clienteId, estado])
  @@index([estado, actualizadoEn])
}

model EnvioCargaDetalle {
  id                     Int @id @default(autoincrement())
  envioDespachoId        Int
  ordenDespachoDetalleId Int
  productoId             Int

  cantidadPlanificada Int
  cantidadCargada     Int @default(0)

  observaciones String?
  version       Int     @default(0)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  envioDespacho        EnvioDespacho        @relation(fields: [envioDespachoId], references: [id], onDelete: Cascade)
  ordenDespachoDetalle OrdenDespachoDetalle @relation(fields: [ordenDespachoDetalleId], references: [id], onDelete: Restrict)
  producto             Producto             @relation(fields: [productoId], references: [id], onDelete: Restrict)

  @@unique([envioDespachoId, ordenDespachoDetalleId])
  @@index([ordenDespachoDetalleId])
  @@index([productoId])
}

model EnvioEvento {
  id        Int  @id @default(autoincrement())
  envioId   Int
  usuarioId Int?

  tipo   TipoEventoEnvio
  estado EstadoEnvio

  descripcion String?

  latitud  Decimal? @db.Decimal(10, 7)
  longitud Decimal? @db.Decimal(10, 7)

  claveIdempotencia String? @unique
  metadata          Json?

  creadoEn DateTime @default(now())

  envio   Envio    @relation(fields: [envioId], references: [id], onDelete: Cascade)
  usuario Usuario? @relation("EnvioEventoUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([envioId, creadoEn])
  @@index([tipo, creadoEn])
  @@index([usuarioId, creadoEn])
}

model EnvioIncidencia {
  id      Int @id @default(autoincrement())
  envioId Int

  tipo      TipoIncidenciaEnvio
  severidad SeveridadIncidenciaEnvio @default(MEDIA)
  estado    EstadoIncidenciaEnvio    @default(ABIERTA)

  descripcion String

  reportadaPorId Int?
  reportadaEn    DateTime @default(now())

  latitud  Decimal? @db.Decimal(10, 7)
  longitud Decimal? @db.Decimal(10, 7)

  resueltaPorId Int?
  resueltaEn    DateTime?
  resolucion    String?

  claveIdempotencia String? @unique
  version           Int     @default(0)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  envio Envio @relation(fields: [envioId], references: [id], onDelete: Cascade)

  reportadaPor Usuario? @relation("EnvioIncidenciaReportadaPor", fields: [reportadaPorId], references: [id], onDelete: SetNull)
  resueltaPor  Usuario? @relation("EnvioIncidenciaResueltaPor", fields: [resueltaPorId], references: [id], onDelete: SetNull)

  @@index([envioId, estado, reportadaEn])
  @@index([tipo, severidad, reportadaEn])
}

// ============================================================================
// PAGOS, FACTURACION Y CUENTAS POR COBRAR
// ============================================================================

model Banco {
  id            Int      @id @default(autoincrement())
  empresaId     Int
  nombre        String
  codigo        String?
  cuenta        String?
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  pagos   Pago[]

  @@index([empresaId, activo])
}

model Pago {
  id        Int @id @default(autoincrement())
  empresaId Int
  clienteId Int
  pedidoId  Int?
  bancoId   Int?

  // --------------------------------------------------------------------------
  // AUDITORÍA DE ACTORES
  // --------------------------------------------------------------------------

  registradoPorId Int?
  verificadoPorId Int?
  rechazadoPorId  Int?
  anuladoPorId    Int?

  // --------------------------------------------------------------------------
  // TRANSACCIÓN
  // --------------------------------------------------------------------------

  metodo MetodoPagoOperacion

  estado EstadoPagoTransaccion @default(PENDIENTE)

  moneda String @default("GTQ")

  monto Decimal @db.Decimal(12, 2)

  // Número de transferencia, depósito, cheque, autorización, etc.
  // No debe ser @unique global porque distintas cuentas/bancos podrían
  // utilizar referencias coincidentes.
  referencia String?

  fechaPago DateTime @default(now())

  // --------------------------------------------------------------------------
  // VERIFICACIÓN
  // --------------------------------------------------------------------------

  verificadoEn DateTime?

  rechazadoEn   DateTime?
  motivoRechazo String?

  anuladoEn       DateTime?
  motivoAnulacion String?

  observaciones String?

  // --------------------------------------------------------------------------
  // IDEMPOTENCIA / CONCURRENCIA
  // --------------------------------------------------------------------------

  // Nullable para compatibilidad con registros históricos.
  // Los casos de uso nuevos exigirán una clave.
  claveIdempotencia String? @unique

  version Int @default(0)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // --------------------------------------------------------------------------
  // RELACIONES
  // --------------------------------------------------------------------------

  empresa Empresa @relation(fields: [empresaId],references: [id],onDelete: Restrict)

  cliente Cliente @relation(fields: [clienteId],references: [id],onDelete: Restrict)

  pedido Pedido? @relation(fields: [pedidoId],references: [id],onDelete: SetNull)

  banco Banco? @relation(fields: [bancoId],references: [id],onDelete: SetNull)

  registradoPor Usuario? @relation("PagoRegistradoPor",fields: [registradoPorId],references: [id],onDelete: SetNull)

  verificadoPor Usuario? @relation("PagoVerificadoPor",fields: [verificadoPorId],    references: [id],onDelete: SetNull)

  rechazadoPor Usuario? @relation("PagoRechazadoPor",fields: [rechazadoPorId],references: [id],onDelete: SetNull)

  anuladoPor Usuario? @relation("PagoAnuladoPor",fields: [anuladoPorId],references: [id],onDelete: SetNull)

  comprobantes PagoComprobante[]
  aplicaciones PagoAplicacion[]
  eventos      PagoEvento[]

  // --------------------------------------------------------------------------
  // ÍNDICES
  // --------------------------------------------------------------------------

  @@index([empresaId, estado, fechaPago])
  @@index([clienteId, fechaPago])
  @@index([pedidoId, fechaPago])
  @@index([bancoId, fechaPago])
  @@index([empresaId, referencia])
  @@index([registradoPorId, fechaPago])
  @@index([verificadoPorId, verificadoEn])
}

model PagoComprobante {
  id     Int @id @default(autoincrement())
  pagoId Int

  subidoPorId Int?

  url String
  key String?

  mimeType String?
  size     Int?

  descripcion String?

  claveIdempotencia String? @unique

  creadoEn DateTime @default(now())

  pago Pago @relation(fields: [pagoId],references: [id],onDelete: Cascade)

  subidoPor Usuario? @relation("PagoComprobanteSubidoPor",fields: [subidoPorId],references: [id],onDelete: SetNull)

  @@index([pagoId, creadoEn])
  @@index([subidoPorId, creadoEn])
}

model PagoEvento {
  id        Int @id @default(autoincrement())
  pagoId    Int
  usuarioId Int?

  tipo   TipoEventoPago
  estado EstadoPagoTransaccion

  detalle String?

  referenciaTipo String?
  referenciaId   Int?

  claveIdempotencia String? @unique

  metadata Json?

  creadoEn DateTime @default(now())

  pago Pago @relation(fields: [pagoId],references: [id],onDelete: Cascade)

  usuario Usuario? @relation("PagoEventoUsuario",fields: [usuarioId],references: [id],onDelete: SetNull)

  @@index([pagoId, creadoEn])
  @@index([tipo, creadoEn])
  @@index([estado, creadoEn])
  @@index([usuarioId, creadoEn])
  @@index([referenciaTipo, referenciaId])
}


model Factura {
  id          Int @id @default(autoincrement())
  empresaId   Int
  clienteId   Int
  pedidoId    Int?
  ventaId     Int?
  creadoPorId Int?

  numero String?
  serie  String?

  estado        EstadoFactura @default(BORRADOR)
  condicionPago CondicionPago?
  moneda        String @default("GTQ")

  subtotal       Decimal @db.Decimal(12, 2)
  descuentoTotal Decimal @default(0) @db.Decimal(12, 2)
  impuestoTotal  Decimal @default(0) @db.Decimal(12, 2)
  total          Decimal @db.Decimal(12, 2)

  emitidaEn        DateTime?
  fechaVencimiento DateTime?

  anuladaEn       DateTime?
  motivoAnulacion String?

  claveIdempotencia String? @unique
  version           Int @default(0)

  descartadaEn     DateTime?
  motivoDescarte   String?


  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  pedido    Pedido?  @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  venta     Venta?   @relation(fields: [ventaId], references: [id], onDelete: SetNull)
  creadoPor Usuario? @relation("FacturaCreadaPor", fields: [creadoPorId], references: [id], onDelete: SetNull)

  entregas        FacturaEntrega[]
  detalles        FacturaDetalle[]
  documentoFiscal DocumentoFiscal?
  cuentaPorCobrar CuentaPorCobrar?
  eventos FacturaEvento[]

  @@unique([empresaId, serie, numero])
  @@index([empresaId, estado, creadoEn])
  @@index([clienteId, creadoEn])
  @@index([pedidoId, creadoEn])
  @@index([creadoPorId, creadoEn])
}





model FacturaEntrega {
  facturaId Int
  entregaId Int

  creadoEn DateTime @default(now())

  factura Factura @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  entrega Entrega @relation(fields: [entregaId], references: [id], onDelete: Restrict)

  @@id([facturaId, entregaId])
  @@index([entregaId])
}





model FacturaDetalle {
  id               Int @id @default(autoincrement())
  facturaId        Int
  productoId       Int
  pedidoDetalleId  Int?
  entregaDetalleId Int?

  descripcion   String
  bienOServicio TipoBienServicioFiscal
  unidadMedida  String @db.VarChar(16)

  cantidad       Int
  precioUnitario Decimal @db.Decimal(12, 2)
  precioBruto    Decimal @db.Decimal(12, 2)
  descuento      Decimal @default(0) @db.Decimal(12, 2)
  impuestoTotal  Decimal @default(0) @db.Decimal(12, 2)
  totalLinea     Decimal @db.Decimal(12, 2)

  creadoEn DateTime @default(now())

  factura        Factura         @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  producto       Producto        @relation(fields: [productoId], references: [id], onDelete: Restrict)
  pedidoDetalle  PedidoDetalle?  @relation(fields: [pedidoDetalleId], references: [id], onDelete: SetNull)
  entregaDetalle EntregaDetalle? @relation(fields: [entregaDetalleId], references: [id], onDelete: SetNull)

  impuestos FacturaDetalleImpuesto[]

  @@index([facturaId])
  @@index([productoId])
  @@index([pedidoDetalleId])
  @@index([entregaDetalleId])
}


model FacturaDetalleImpuesto {
  id               Int @id @default(autoincrement())
  facturaDetalleId Int

  nombreCorto          String
  codigoUnidadGravable Int?
  montoGravable        Decimal @db.Decimal(18, 8)
  montoImpuesto        Decimal @db.Decimal(18, 8)

  tasa Decimal? @db.Decimal(7, 4)

  creadoEn DateTime @default(now())

  facturaDetalle FacturaDetalle @relation(fields: [facturaDetalleId], references: [id], onDelete: Cascade)

  @@index([facturaDetalleId])
  @@index([nombreCorto])
}



