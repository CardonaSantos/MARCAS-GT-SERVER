model FelOperacion {
  id                   Int @id @default(autoincrement())
  documentoFiscalId    Int
  proveedorFelConfigId Int

  tipo   TipoOperacionFel
  estado EstadoOperacionFel @default(PENDIENTE)

  claveIdempotencia String @unique

  intentos    Int @default(0)
  maxIntentos Int @default(5)

  disponibleEn   DateTime?
  bloqueadaHasta DateTime?
  workerId       String?

  refIdProveedor String?

  ultimoCodigoError  String?
  ultimoMensajeError String?

  iniciadaEn   DateTime?
  finalizadaEn DateTime?

  version Int @default(0)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  documentoFiscal DocumentoFiscal     @relation(fields: [documentoFiscalId], references: [id], onDelete: Cascade)
  proveedorConfig EmpresaProveedorFel @relation(fields: [proveedorFelConfigId], references: [id], onDelete: Restrict)

  intentosHttp FelIntento[]

  @@index([estado, disponibleEn])
  @@index([documentoFiscalId, tipo, estado])
  @@index([proveedorFelConfigId, estado])
}

model FelIntento {
  id          Int @id @default(autoincrement())
  operacionId Int

  numeroIntento Int

  iniciadoEn   DateTime @default(now())
  finalizadoEn DateTime?

  httpStatus Int?
  duracionMs Int?

  requestHash String? @db.VarChar(64)

  codigoProveedor  String?
  mensajeProveedor String?
  refIdProveedor   String?

  respuestaResumen Json?
  errorTipo        String?

  operacion FelOperacion @relation(fields: [operacionId], references: [id], onDelete: Cascade)

  @@unique([operacionId, numeroIntento])
  @@index([operacionId, iniciadoEn])
}

