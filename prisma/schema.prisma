model DocumentoFiscal {
  id                      Int @id @default(autoincrement())
  facturaId               Int @unique
  empresaId               Int
  establecimientoFiscalId Int
  proveedorFelConfigId    Int?
  contingenciaId          Int?

  tipoDte String @db.VarChar(8)

  estado  EstadoDocumentoFiscal @default(BORRADOR)
  entorno EntornoFel

  codigoMoneda     String   @default("GTQ") @db.VarChar(8)
  fechaHoraEmision DateTime
  granTotal         Decimal @db.Decimal(12, 2)

  serieInterna  String
  numeroInterno Int

  uuid               String?   @unique @db.VarChar(64)
  serieFel           String?
  numeroFel          String?
  fechaCertificacion DateTime?

  refIdProveedor String?

  certificadorNit    String?
  certificadorNombre String?

  numeroAcceso String?

  emisorNit             String
  emisorNombre          String
  emisorNombreComercial String
  emisorAfiliacionIva   String
  emisorCorreo          String?
  emisorDireccion       Json

  receptorTipoIdentificacion TipoIdentificacionFiscal
  receptorIdentificacion     String
  receptorNombre             String
  receptorCorreo             String?
  receptorDireccion          Json?

  frases       Json?
  adendas      Json?
  complementos Json?

  payloadHash    String @db.VarChar(64)
  versionEsquema String?

  anuladoEn       DateTime?
  motivoAnulacion String?

  version Int @default(0)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  factura         Factura               @relation(fields: [facturaId], references: [id], onDelete: Restrict)
  empresa         Empresa               @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  establecimiento EstablecimientoFiscal @relation(fields: [establecimientoFiscalId], references: [id], onDelete: Restrict)
  proveedorConfig EmpresaProveedorFel?  @relation(fields: [proveedorFelConfigId], references: [id], onDelete: SetNull)
  contingencia    FelContingencia?      @relation(fields: [contingenciaId], references: [id], onDelete: SetNull)

  artefactos DocumentoFiscalArtefacto[]
  operaciones FelOperacion[]
  eventos     DocumentoFiscalEvento[]

  @@unique([empresaId, establecimientoFiscalId, entorno, serieInterna, numeroInterno])
  @@unique([proveedorFelConfigId, refIdProveedor])
  @@index([empresaId, estado, fechaHoraEmision])
  @@index([establecimientoFiscalId, estado, fechaHoraEmision])
  @@index([contingenciaId])
}

model DocumentoFiscalArtefacto {
  id                Int @id @default(autoincrement())
  documentoFiscalId Int

  tipo    TipoArtefactoFiscal
  version Int @default(1)

  contenido  String? @db.Text
  storageKey String?
  url        String?
  mimeType   String?
  size       Int?
  sha256     String? @db.VarChar(64)

  creadoEn DateTime @default(now())

  documentoFiscal DocumentoFiscal @relation(fields: [documentoFiscalId], references: [id], onDelete: Cascade)

  @@unique([documentoFiscalId, tipo, version])
  @@index([documentoFiscalId, creadoEn])
}


model DocumentoFiscalEvento {
  id                Int @id @default(autoincrement())
  documentoFiscalId Int
  usuarioId         Int?

  tipo   TipoEventoDocumentoFiscal
  estado EstadoDocumentoFiscal

  detalle String?

  referenciaTipo String?
  referenciaId   Int?

  claveIdempotencia String? @unique
  metadata          Json?

  creadoEn DateTime @default(now())

  documentoFiscal DocumentoFiscal @relation(fields: [documentoFiscalId], references: [id], onDelete: Cascade)
  usuario          Usuario?        @relation("DocumentoFiscalEventoUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([documentoFiscalId, creadoEn])
  @@index([tipo, creadoEn])
  @@index([estado, creadoEn])
  @@index([usuarioId, creadoEn])
  @@index([referenciaTipo, referenciaId])
}


