model CuentaPorCobrar {
  id        Int @id @default(autoincrement())
  empresaId Int
  clienteId Int
  pedidoId  Int?
  facturaId Int? @unique
  creditoId Int?

  numeroDocumento String?
  moneda          String @default("GTQ")

  montoOriginal  Decimal @db.Decimal(12, 2)
  saldoPendiente Decimal @db.Decimal(12, 2)

  fechaEmision     DateTime @default(now())
  fechaVencimiento DateTime

  estado EstadoCuentaPorCobrar @default(PENDIENTE)

  anuladaEn       DateTime?
  motivoAnulacion String?

  claveIdempotencia String? @unique
  version           Int @default(0)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  pedido  Pedido? @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  factura Factura? @relation(fields: [facturaId], references: [id], onDelete: SetNull)
  credito Credito? @relation(fields: [creditoId], references: [id], onDelete: SetNull)

  aplicaciones PagoAplicacion[]

  @@index([empresaId, estado, fechaVencimiento])
  @@index([clienteId, estado])
  @@index([pedidoId, estado])
}










model PagoAplicacion {
  id                Int @id @default(autoincrement())
  pagoId            Int
  cuentaPorCobrarId Int

  monto Decimal @db.Decimal(12, 2)

  estado EstadoPagoAplicacion @default(ACTIVA)

  // --------------------------------------------------------------------------
  // AUDITORÍA
  // --------------------------------------------------------------------------

  aplicadoPorId Int?

  revertidaEn     DateTime?
  revertidaPorId  Int?
  motivoReversion String?

  // Nullable por compatibilidad con posibles registros históricos.
  // Las nuevas operaciones sí deben enviarla.
  claveIdempotencia String? @unique

  version Int @default(0)

  creadoEn DateTime @default(now())

  // --------------------------------------------------------------------------
  // RELACIONES
  // --------------------------------------------------------------------------

  pago Pago @relation(fields: [pagoId],references: [id],onDelete: Restrict)

  cuentaPorCobrar CuentaPorCobrar @relation(fields: [cuentaPorCobrarId],references: [id],onDelete: Restrict)

  aplicadoPor Usuario? @relation("PagoAplicadoPor",fields: [aplicadoPorId],references: [id],onDelete: SetNull)

  revertidaPor Usuario? @relation("PagoAplicacionRevertidaPor",fields: [revertidaPorId],references: [id],onDelete: SetNull)

  // Ya NO usamos @@unique([pagoId, cuentaPorCobrarId])

  @@index([pagoId, estado])
  @@index([cuentaPorCobrarId, estado])
  @@index([aplicadoPorId, creadoEn])
  @@index([revertidaPorId, revertidaEn])
}




