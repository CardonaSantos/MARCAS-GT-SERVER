  CANCELADO
}

// ============================================================================
// JORNADA Y TRACKING
// ============================================================================

model SesionTrackingUsuario {
  id                 Int                  @id @default(autoincrement())
  usuarioId          Int
  asistenciaId       Int?
  estado             EstadoSesionTracking @default(ACTIVA)
  iniciadaEn         DateTime             @default(now())
  finalizadaEn       DateTime?
  ultimoHeartbeatEn  DateTime             @default(now())
  motivoCierre       String?
  dispositivoId      String?
  plataforma         String?
  creadoEn           DateTime             @default(now())
  actualizadoEn      DateTime             @updatedAt

  usuario            Usuario              @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  asistencia         Asistencia?          @relation(fields: [asistenciaId], references: [id], onDelete: SetNull)
  ubicaciones        UbicacionUsuarioHistorial[]
  ubicacionActual    UbicacionUsuarioActual?

  @@index([usuarioId, estado])
  @@index([asistenciaId])
  @@index([ultimoHeartbeatEn])
}

model UbicacionUsuarioHistorial {
  id             Int                   @id @default(autoincrement())
  sesionId       Int
  latitud        Decimal               @db.Decimal(10, 7)
  longitud       Decimal               @db.Decimal(10, 7)
  precisionM     Decimal?              @db.Decimal(10, 2)
  velocidadMps   Decimal?              @db.Decimal(10, 2)
  bateriaPct     Int?
  capturadoEn    DateTime
  persistidoEn   DateTime              @default(now())

  sesion         SesionTrackingUsuario @relation(fields: [sesionId], references: [id], onDelete: Cascade)

  @@index([sesionId, capturadoEn])
}

model UbicacionUsuarioActual {
  id             Int                   @id @default(autoincrement())
  sesionId       Int                   @unique
  usuarioId      Int                   @unique
  latitud        Decimal               @db.Decimal(10, 7)
  longitud       Decimal               @db.Decimal(10, 7)
  precisionM     Decimal?              @db.Decimal(10, 2)
  velocidadMps   Decimal?              @db.Decimal(10, 2)
  bateriaPct     Int?
  capturadoEn    DateTime
  persistidoEn   DateTime              @default(now())
  actualizadoEn  DateTime              @updatedAt

  sesion         SesionTrackingUsuario @relation(fields: [sesionId], references: [id], onDelete: Cascade)
  usuario        Usuario               @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

// ============================================================================
// INVENTARIO Y BODEGAS
// ============================================================================

model Bodega {
  id                    Int      @id @default(autoincrement())
  empresaId             Int
  codigo                String
  nombre                String
  direccion             String?
  activo                Boolean  @default(true)
  creadoEn              DateTime @default(now())
  actualizadoEn         DateTime @updatedAt

  empresa               Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  stocks                StockBodega[]
  movimientos           MovimientoInventario[]
  requisiciones         Requisicion[]
  transferenciasOrigen  TransferenciaBodega[] @relation("TransferenciaBodegaOrigen")
  transferenciasDestino TransferenciaBodega[] @relation("TransferenciaBodegaDestino")
  ordenesDespacho       OrdenDespacho[]

  @@unique([empresaId, codigo])
  @@index([empresaId, activo])
}

model StockBodega {
  id                  Int      @id @default(autoincrement())
  bodegaId            Int
  productoId          Int
  cantidadReal        Int      @default(0)
  cantidadReservada   Int      @default(0)
  cantidadDisponible  Int      @default(0)
  costoPromedio       Decimal  @default(0) @db.Decimal(12, 2)
  creadoEn            DateTime @default(now())
  actualizadoEn       DateTime @updatedAt

  bodega              Bodega   @relation(fields: [bodegaId], references: [id], onDelete: Restrict)
  producto            Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  reservas            ReservaInventario[]

  @@unique([bodegaId, productoId])
  @@index([productoId])
}

model Requisicion {
  id              Int               @id @default(autoincrement())
  empresaId       Int
  bodegaDestinoId Int
  proveedorId     Int?
  solicitanteId   Int
  estado          EstadoRequisicion @default(BORRADOR)
  observaciones   String?
  solicitadaEn    DateTime?
  aprobadaEn      DateTime?
  completadaEn    DateTime?
  creadoEn        DateTime          @default(now())
  actualizadoEn   DateTime          @updatedAt

  empresa         Empresa           @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  bodegaDestino   Bodega            @relation(fields: [bodegaDestinoId], references: [id], onDelete: Restrict)
  proveedor       Proveedor?        @relation(fields: [proveedorId], references: [id], onDelete: SetNull)
  solicitante     Usuario           @relation("RequisicionSolicitante", fields: [solicitanteId], references: [id], onDelete: Restrict)
  detalles        RequisicionDetalle[]

  @@index([empresaId, estado])
  @@index([bodegaDestinoId])
}

model RequisicionDetalle {
  id                 Int         @id @default(autoincrement())
  requisicionId      Int
  productoId         Int
  cantidadSolicitada Int
  cantidadRecibida   Int         @default(0)
  costoEstimado      Decimal?    @db.Decimal(12, 2)
  creadoEn           DateTime    @default(now())
  actualizadoEn      DateTime    @updatedAt

  requisicion        Requisicion @relation(fields: [requisicionId], references: [id], onDelete: Cascade)
  producto           Producto    @relation(fields: [productoId], references: [id], onDelete: Restrict)

  @@unique([requisicionId, productoId])
}

model TransferenciaBodega {
  id               Int                       @id @default(autoincrement())
  bodegaOrigenId   Int
  bodegaDestinoId  Int
  creadoPorId      Int
  estado           EstadoTransferenciaBodega @default(BORRADOR)
  observaciones    String?
  enviadaEn        DateTime?
  recibidaEn       DateTime?
  creadoEn         DateTime                  @default(now())
  actualizadoEn    DateTime                  @updatedAt

  bodegaOrigen     Bodega                    @relation("TransferenciaBodegaOrigen", fields: [bodegaOrigenId], references: [id], onDelete: Restrict)
  bodegaDestino    Bodega                    @relation("TransferenciaBodegaDestino", fields: [bodegaDestinoId], references: [id], onDelete: Restrict)
  creadoPor        Usuario                   @relation("TransferenciaCreadaPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  detalles         TransferenciaBodegaDetalle[]

  @@index([bodegaOrigenId, estado])
  @@index([bodegaDestinoId, estado])
}

model TransferenciaBodegaDetalle {
  id                    Int                 @id @default(autoincrement())
  transferenciaId       Int
  productoId            Int
  cantidadSolicitada    Int
  cantidadEnviada       Int                 @default(0)
  cantidadRecibida      Int                 @default(0)

  transferencia         TransferenciaBodega @relation(fields: [transferenciaId], references: [id], onDelete: Cascade)
  producto              Producto            @relation(fields: [productoId], references: [id], onDelete: Restrict)

  @@unique([transferenciaId, productoId])
}

model MovimientoInventario {
  id                   Int                       @id @default(autoincrement())
  bodegaId             Int
  productoId           Int
  proveedorId          Int?
  creadoPorId          Int?
  tipo                 TipoMovimientoInventario
  cantidad             Int
  costoUnitario        Decimal?                  @db.Decimal(12, 2)
  cantidadRealAntes    Int
  cantidadRealDespues  Int
  reservadaAntes       Int
  reservadaDespues     Int
  referenciaTipo       String?
  referenciaId         Int?
  observaciones        String?
  creadoEn             DateTime                  @default(now())

  bodega               Bodega                    @relation(fields: [bodegaId], references: [id], onDelete: Restrict)
  producto             Producto                  @relation(fields: [productoId], references: [id], onDelete: Restrict)
  proveedor            Proveedor?                @relation(fields: [proveedorId], references: [id], onDelete: SetNull)
  creadoPor            Usuario?                  @relation("MovimientoInventarioCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)

  @@index([bodegaId, productoId, creadoEn])
  @@index([referenciaTipo, referenciaId])
}

model ReservaInventario {
  id               Int                     @id @default(autoincrement())
  pedidoDetalleId  Int
  stockBodegaId    Int
  cantidad         Int
  estado           EstadoReservaInventario @default(ACTIVA)
  aplicadaEn       DateTime?
  liberadaEn       DateTime?
  creadoEn         DateTime                @default(now())
  actualizadoEn    DateTime                @updatedAt

  pedidoDetalle    PedidoDetalle           @relation(fields: [pedidoDetalleId], references: [id], onDelete: Cascade)
  stockBodega      StockBodega             @relation(fields: [stockBodegaId], references: [id], onDelete: Restrict)

  @@unique([pedidoDetalleId, stockBodegaId])
  @@index([stockBodegaId, estado])
}

// ============================================================================
// PEDIDOS
// ============================================================================

model Pedido {
  id                 Int                 @id @default(autoincrement())
  empresaId          Int
  clienteId          Int
  vendedorId         Int
  visitaId           Int?
  estado             EstadoPedido        @default(BORRADOR)
  condicionPago      CondicionPago
  estadoPago         EstadoPagoComercial @default(PENDIENTE)
  moneda             String              @default("GTQ")
  subtotal           Decimal             @default(0) @db.Decimal(12, 2)
  descuentoTotal     Decimal             @default(0) @db.Decimal(12, 2)
  total              Decimal             @default(0) @db.Decimal(12, 2)
  observaciones      String?
  confirmadoEn       DateTime?
  canceladoEn        DateTime?
  creadoEn           DateTime            @default(now())
  actualizadoEn      DateTime            @updatedAt

  empresa            Empresa             @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  cliente            Cliente             @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  vendedor           Usuario             @relation("PedidoVendedor", fields: [vendedorId], references: [id], onDelete: Restrict)
  visita             Visita?             @relation(fields: [visitaId], references: [id], onDelete: SetNull)
  detalles           PedidoDetalle[]
  eventos            PedidoEvento[]
  solicitudesCredito SolicitudCredito[]
  ordenesDespacho    OrdenDespacho[]
  pagos              Pago[]
  cuentasPorCobrar   CuentaPorCobrar[]
  facturas           Factura[]
  entregas           Entrega[]

  @@index([empresaId, estado, creadoEn])
  @@index([clienteId, creadoEn])
  @@index([vendedorId, creadoEn])
}

model PedidoDetalle {
  id                 Int      @id @default(autoincrement())
  pedidoId           Int
  productoId         Int
  cantidadSolicitada Int
  cantidadReservada  Int      @default(0)
  cantidadDespachada Int      @default(0)
  cantidadEntregada  Int      @default(0)
  precioUnitario     Decimal  @db.Decimal(12, 2)
  descuento          Decimal  @default(0) @db.Decimal(12, 2)
  subtotal           Decimal  @db.Decimal(12, 2)
  creadoEn           DateTime @default(now())
  actualizadoEn      DateTime @updatedAt

  pedido             Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto           Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  reservas           ReservaInventario[]
  despachoDetalles   OrdenDespachoDetalle[]
  entregaDetalles    EntregaDetalle[]
  facturaDetalles    FacturaDetalle[]

  @@unique([pedidoId, productoId])
}

model PedidoEvento {
  id          Int              @id @default(autoincrement())
  pedidoId    Int
  usuarioId   Int?
  tipo        TipoEventoPedido
  detalle     String?
  metadata    Json?
  creadoEn    DateTime         @default(now())

  pedido      Pedido           @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  usuario     Usuario?         @relation("PedidoEventoUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([pedidoId, creadoEn])
}

// ============================================================================
// CREDITO
// ============================================================================

model PoliticaCredito {
  id                 Int      @id @default(autoincrement())
  empresaId          Int
  nombre             String
  descripcion        String?
  activo             Boolean  @default(true)
  montoMaximo        Decimal? @db.Decimal(12, 2)
  plazoMaximoDias    Int?
  porcentajeAnticipo Decimal? @db.Decimal(5, 2)
  creadoEn           DateTime @default(now())
  actualizadoEn      DateTime @updatedAt

  empresa            Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  requisitos         PoliticaCreditoRequisito[]
  solicitudes        SolicitudCredito[]

  @@index([empresaId, activo])
}

model PoliticaCreditoRequisito {
  id          Int             @id @default(autoincrement())
  politicaId  Int
  codigo      String
  nombre      String
  descripcion String?
  obligatorio Boolean         @default(true)
  orden       Int             @default(0)

  politica    PoliticaCredito @relation(fields: [politicaId], references: [id], onDelete: Cascade)

  @@unique([politicaId, codigo])
}

model SolicitudCredito {
  id                Int                    @id @default(autoincrement())
  empresaId         Int
  pedidoId          Int
  clienteId         Int
  solicitanteId     Int
  politicaId        Int?
  creditoId         Int?                   @unique
  montoSolicitado   Decimal                @db.Decimal(12, 2)
  plazoDias         Int
  anticipoPropuesto Decimal                @default(0) @db.Decimal(12, 2)
  estado            EstadoSolicitudCredito @default(PENDIENTE)
  motivo            String?
  solicitadaEn      DateTime               @default(now())
  resueltaEn        DateTime?
  actualizadoEn     DateTime               @updatedAt

  empresa           Empresa                @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  pedido            Pedido                 @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  cliente           Cliente                @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  solicitante       Usuario                @relation("SolicitudCreditoSolicitante", fields: [solicitanteId], references: [id], onDelete: Restrict)
  politica          PoliticaCredito?       @relation(fields: [politicaId], references: [id], onDelete: SetNull)
  credito           Credito?               @relation(fields: [creditoId], references: [id], onDelete: SetNull)
  referencias       ReferenciaCredito[]
  documentos        DocumentoCredito[]
  decisiones        DecisionCredito[]

  @@index([empresaId, estado, solicitadaEn])
  @@index([pedidoId])
  @@index([clienteId])
}

model ReferenciaCredito {
  id             Int                          @id @default(autoincrement())
  solicitudId    Int
  tipo           TipoReferenciaCredito
  nombre         String
  telefono       String
  relacion       String?
  resultado      EstadoVerificacionReferencia @default(PENDIENTE)
  verificadoEn   DateTime?
  observaciones  String?
  creadoEn       DateTime                     @default(now())

  solicitud      SolicitudCredito             @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  @@index([solicitudId, resultado])
}

model DocumentoCredito {
  id            Int                    @id @default(autoincrement())
  solicitudId   Int
  tipo          TipoDocumentoCredito
  url           String
  key           String?
  mimeType      String?
  size          Int?
  estado        EstadoDocumentoCredito @default(PENDIENTE)
  observaciones String?
  creadoEn      DateTime               @default(now())

  solicitud     SolicitudCredito       @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  @@index([solicitudId, tipo])
}

model DecisionCredito {
  id                  Int                  @id @default(autoincrement())
  solicitudId         Int
  decididoPorId       Int
  tipo                TipoDecisionCredito
  montoAutorizado     Decimal?             @db.Decimal(12, 2)
  plazoAutorizadoDias Int?
  anticipoRequerido   Decimal?             @db.Decimal(12, 2)
  observaciones       String?
  creadoEn            DateTime             @default(now())

  solicitud           SolicitudCredito     @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  decididoPor         Usuario              @relation("DecisionCreditoUsuario", fields: [decididoPorId], references: [id], onDelete: Restrict)

  @@index([solicitudId, creadoEn])
}

// ============================================================================
// PREPARACION, DESPACHO Y ENTREGA
// ============================================================================

model OrdenDespacho {
  id              Int                 @id @default(autoincrement())
  pedidoId        Int
  bodegaId        Int
  preparadoPorId  Int?
  numero          String?
  estado          EstadoOrdenDespacho @default(PENDIENTE)
  programadoEn    DateTime?
  preparadoEn     DateTime?
  despachadoEn    DateTime?
  observaciones   String?
  creadoEn        DateTime            @default(now())
  actualizadoEn   DateTime            @updatedAt

  pedido          Pedido              @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  bodega          Bodega              @relation(fields: [bodegaId], references: [id], onDelete: Restrict)
  preparadoPor    Usuario?            @relation("OrdenDespachoPreparadoPor", fields: [preparadoPorId], references: [id], onDelete: SetNull)
  detalles        OrdenDespachoDetalle[]
  eventos         OrdenDespachoEvento[]
  envios          EnvioDespacho[]
  entregas        Entrega[]

  @@index([pedidoId, estado])
  @@index([bodegaId, estado])
}

model OrdenDespachoDetalle {
  id                  Int           @id @default(autoincrement())
  ordenDespachoId     Int
  pedidoDetalleId     Int
  productoId          Int
  cantidadPreparada   Int           @default(0)
  cantidadDespachada  Int           @default(0)

  ordenDespacho       OrdenDespacho @relation(fields: [ordenDespachoId], references: [id], onDelete: Cascade)
  pedidoDetalle       PedidoDetalle @relation(fields: [pedidoDetalleId], references: [id], onDelete: Restrict)
  producto            Producto      @relation(fields: [productoId], references: [id], onDelete: Restrict)
  entregaDetalles     EntregaDetalle[]

  @@unique([ordenDespachoId, pedidoDetalleId])
}

model OrdenDespachoEvento {
  id               Int                      @id @default(autoincrement())
  ordenDespachoId  Int
  usuarioId        Int?
  tipo             TipoEventoOrdenDespacho
  detalle          String?
  creadoEn         DateTime                 @default(now())

  ordenDespacho    OrdenDespacho            @relation(fields: [ordenDespachoId], references: [id], onDelete: Cascade)
  usuario          Usuario?                 @relation("OrdenDespachoEventoUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([ordenDespachoId, creadoEn])
}

model Entrega {
  id                 Int           @id @default(autoincrement())
  ordenDespachoId    Int
  pedidoId           Int
  clienteId          Int
  registradoPorId    Int?
  estado             EstadoEntrega @default(PENDIENTE)
  receptorNombre     String?
  receptorDocumento  String?
  firmaUrl           String?
  latitud            Decimal?      @db.Decimal(10, 7)
  longitud           Decimal?      @db.Decimal(10, 7)
  entregadoEn        DateTime?
  observaciones      String?
  creadoEn           DateTime      @default(now())
  actualizadoEn      DateTime      @updatedAt

  ordenDespacho      OrdenDespacho @relation(fields: [ordenDespachoId], references: [id], onDelete: Restrict)
  pedido             Pedido        @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  cliente            Cliente       @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  registradoPor      Usuario?      @relation("EntregaRegistradaPor", fields: [registradoPorId], references: [id], onDelete: SetNull)
  detalles           EntregaDetalle[]
  evidencias         EntregaEvidencia[]
  factura            Factura?

  @@index([pedidoId, estado])
  @@index([ordenDespachoId])
}

model EntregaDetalle {
  id                     Int                  @id @default(autoincrement())
  entregaId              Int
  ordenDespachoDetalleId Int
  pedidoDetalleId        Int
  productoId             Int
  cantidadEntregada      Int
  cantidadRechazada      Int                  @default(0)
  motivoRechazo          String?

  entrega                Entrega              @relation(fields: [entregaId], references: [id], onDelete: Cascade)
  ordenDespachoDetalle   OrdenDespachoDetalle @relation(fields: [ordenDespachoDetalleId], references: [id], onDelete: Restrict)
  pedidoDetalle          PedidoDetalle        @relation(fields: [pedidoDetalleId], references: [id], onDelete: Restrict)
  producto               Producto             @relation(fields: [productoId], references: [id], onDelete: Restrict)
  facturaDetalles        FacturaDetalle[]

  @@unique([entregaId, ordenDespachoDetalleId])
}

model EntregaEvidencia {
  id          Int                  @id @default(autoincrement())
  entregaId   Int
  tipo        TipoEvidenciaEntrega
  url         String
  key         String?
  mimeType    String?
  size        Int?
  creadoEn    DateTime             @default(now())

  entrega     Entrega              @relation(fields: [entregaId], references: [id], onDelete: Cascade)

  @@index([entregaId, tipo])
}

// ============================================================================
// TRANSPORTE
// ============================================================================

model Transportista {
  id             Int               @id @default(autoincrement())
  empresaId      Int
  tipo           TipoTransportista
  nombre         String
  telefono       String?
  correo         String?
  activo         Boolean           @default(true)
  creadoEn       DateTime          @default(now())
  actualizadoEn  DateTime          @updatedAt

  empresa        Empresa           @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  vehiculos      Vehiculo[]
  conductores    Conductor[]
  envios         Envio[]

  @@index([empresaId, tipo, activo])
}

model Vehiculo {
  id              Int            @id @default(autoincrement())
  empresaId       Int
  transportistaId Int?
  placa           String
  marca           String?
  modelo          String?
  capacidadKg     Decimal?       @db.Decimal(12, 2)
  estado          EstadoVehiculo @default(DISPONIBLE)
  activo          Boolean        @default(true)
  creadoEn        DateTime       @default(now())
  actualizadoEn   DateTime       @updatedAt

  empresa         Empresa        @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  transportista   Transportista? @relation(fields: [transportistaId], references: [id], onDelete: SetNull)
  envios          Envio[]

  @@unique([empresaId, placa])
  @@index([empresaId, estado, activo])
}

model Conductor {
  id              Int            @id @default(autoincrement())
  empresaId       Int
  transportistaId Int?
  nombre          String
  telefono        String?
  licencia        String?
  activo          Boolean        @default(true)
  creadoEn        DateTime       @default(now())
  actualizadoEn   DateTime       @updatedAt

  empresa         Empresa        @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  transportista   Transportista? @relation(fields: [transportistaId], references: [id], onDelete: SetNull)
  envios          Envio[]

  @@index([empresaId, activo])
}

model Envio {
  id                        Int          @id @default(autoincrement())
  empresaId                 Int
  transportistaId           Int?
  vehiculoId                Int?
  conductorId               Int?
  responsableId             Int?
  estado                    EstadoEnvio  @default(PROGRAMADO)
  guia                      String?
  costo                     Decimal?     @db.Decimal(12, 2)
  trackingUrl               String?
  comprobanteUrl            String?
  entregadoTransportistaEn  DateTime?
  salidaEn                  DateTime?
  completadoEn              DateTime?
  observaciones             String?
  creadoEn                  DateTime     @default(now())
  actualizadoEn             DateTime     @updatedAt

  empresa                   Empresa      @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  transportista             Transportista? @relation(fields: [transportistaId], references: [id], onDelete: SetNull)
  vehiculo                  Vehiculo?    @relation(fields: [vehiculoId], references: [id], onDelete: SetNull)
  conductor                 Conductor?   @relation(fields: [conductorId], references: [id], onDelete: SetNull)
  responsable               Usuario?     @relation("EnvioResponsable", fields: [responsableId], references: [id], onDelete: SetNull)
  despachos                 EnvioDespacho[]
  eventos                   EnvioEvento[]

  @@index([empresaId, estado, creadoEn])
  @@index([guia])
}

model EnvioDespacho {
  id               Int           @id @default(autoincrement())
  envioId          Int
  ordenDespachoId  Int
  creadoEn         DateTime      @default(now())

  envio            Envio         @relation(fields: [envioId], references: [id], onDelete: Cascade)
  ordenDespacho    OrdenDespacho @relation(fields: [ordenDespachoId], references: [id], onDelete: Restrict)

  @@unique([envioId, ordenDespachoId])
  @@index([ordenDespachoId])
}

model EnvioEvento {
  id          Int         @id @default(autoincrement())
  envioId     Int
  usuarioId   Int?
  estado      EstadoEnvio
  descripcion String?
  latitud     Decimal?    @db.Decimal(10, 7)
  longitud    Decimal?    @db.Decimal(10, 7)
  creadoEn    DateTime    @default(now())

  envio       Envio       @relation(fields: [envioId], references: [id], onDelete: Cascade)
  usuario     Usuario?    @relation("EnvioEventoUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([envioId, creadoEn])
}

// ============================================================================
// PAGOS, FACTURACION Y CUENTAS POR COBRAR
// ============================================================================

model Banco {
  id            Int      @id @default(autoincrement())
  empresaId     Int
  nombre        String
  codigo        String?
  cuenta        String?
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  pagos         Pago[]

  @@index([empresaId, activo])
}

model Pago {
  id              Int                   @id @default(autoincrement())
  empresaId       Int
  clienteId       Int
  pedidoId        Int?
  bancoId         Int?
  registradoPorId Int?
  metodo          MetodoPagoOperacion
  estado          EstadoPagoTransaccion @default(PENDIENTE)
  monto           Decimal               @db.Decimal(12, 2)
  referencia      String?
  fechaPago       DateTime              @default(now())
  verificadoEn    DateTime?
  observaciones   String?
  creadoEn        DateTime              @default(now())
  actualizadoEn   DateTime              @updatedAt

  empresa         Empresa               @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  cliente         Cliente               @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  pedido          Pedido?               @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  banco           Banco?                @relation(fields: [bancoId], references: [id], onDelete: SetNull)
  registradoPor   Usuario?              @relation("PagoRegistradoPor", fields: [registradoPorId], references: [id], onDelete: SetNull)
  comprobantes    PagoComprobante[]
  aplicaciones    PagoAplicacion[]

  @@index([empresaId, estado, fechaPago])
  @@index([clienteId, fechaPago])
}

model PagoComprobante {
  id          Int      @id @default(autoincrement())
  pagoId      Int
  url         String
  key         String?
  mimeType    String?
  size        Int?
  creadoEn    DateTime @default(now())

  pago        Pago     @relation(fields: [pagoId], references: [id], onDelete: Cascade)

  @@index([pagoId])
}

model Factura {
  id               Int           @id @default(autoincrement())
  empresaId        Int
  clienteId        Int
  pedidoId         Int?
  entregaId        Int?          @unique
  ventaId          Int?
  numero           String?
  serie            String?
  estado           EstadoFactura @default(BORRADOR)
  moneda           String        @default("GTQ")
  subtotal         Decimal       @db.Decimal(12, 2)
  impuesto         Decimal       @default(0) @db.Decimal(12, 2)
  total            Decimal       @db.Decimal(12, 2)
  emitidaEn        DateTime?
  fechaVencimiento DateTime?
  creadoEn         DateTime      @default(now())
  actualizadoEn    DateTime      @updatedAt

  empresa          Empresa       @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  cliente          Cliente       @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  pedido           Pedido?       @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  entrega          Entrega?      @relation(fields: [entregaId], references: [id], onDelete: SetNull)
  venta            Venta?        @relation(fields: [ventaId], references: [id], onDelete: SetNull)
  detalles         FacturaDetalle[]
  cuentaPorCobrar  CuentaPorCobrar?

  @@index([empresaId, estado, creadoEn])
  @@index([clienteId, creadoEn])
  @@unique([empresaId, serie, numero])
}

model FacturaDetalle {
  id               Int             @id @default(autoincrement())
  facturaId        Int
  productoId       Int
  pedidoDetalleId  Int?
  entregaDetalleId Int?
  cantidad         Int
  precioUnitario   Decimal         @db.Decimal(12, 2)
  descuento        Decimal         @default(0) @db.Decimal(12, 2)
  subtotal         Decimal         @db.Decimal(12, 2)

  factura          Factura         @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  producto         Producto        @relation(fields: [productoId], references: [id], onDelete: Restrict)
  pedidoDetalle    PedidoDetalle?  @relation(fields: [pedidoDetalleId], references: [id], onDelete: SetNull)
  entregaDetalle   EntregaDetalle? @relation(fields: [entregaDetalleId], references: [id], onDelete: SetNull)

  @@index([facturaId])
}

model CuentaPorCobrar {
  id               Int                    @id @default(autoincrement())
  empresaId        Int
  clienteId        Int
  pedidoId         Int?
  facturaId        Int?                   @unique
  creditoId        Int?
  numeroDocumento  String?
  montoOriginal    Decimal                @db.Decimal(12, 2)
  saldoPendiente   Decimal                @db.Decimal(12, 2)
  fechaEmision     DateTime               @default(now())
  fechaVencimiento DateTime
  estado           EstadoCuentaPorCobrar  @default(PENDIENTE)
  creadoEn         DateTime               @default(now())
  actualizadoEn    DateTime               @updatedAt

  empresa          Empresa                @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  cliente          Cliente                @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  pedido           Pedido?                @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  factura          Factura?               @relation(fields: [facturaId], references: [id], onDelete: SetNull)
  credito          Credito?               @relation(fields: [creditoId], references: [id], onDelete: SetNull)
  aplicaciones     PagoAplicacion[]

  @@index([empresaId, estado, fechaVencimiento])
  @@index([clienteId, estado])
}

model PagoAplicacion {
  id                Int             @id @default(autoincrement())
  pagoId            Int
  cuentaPorCobrarId Int
  monto             Decimal         @db.Decimal(12, 2)
  creadoEn          DateTime        @default(now())

  pago              Pago            @relation(fields: [pagoId], references: [id], onDelete: Cascade)
  cuentaPorCobrar   CuentaPorCobrar @relation(fields: [cuentaPorCobrarId], references: [id], onDelete: Cascade)

  @@unique([pagoId, cuentaPorCobrarId])
  @@index([cuentaPorCobrarId])
}

